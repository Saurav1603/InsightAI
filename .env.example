# InsightAI Environment Configuration
ENVIRONMENT=development
DEBUG=True
APP_NAME=InsightAI
API_V1_STR=/api/v1
SECRET_KEY=insightai_super_secret_production_key_change_in_prod_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For local zero-friction without Docker: sqlite:///./insightai.db
# For PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/insightai
DATABASE_URL=sqlite:///./insightai.db

# Multi-Agent & LLM
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gemini-1.5-flash
ENABLE_MOCK_LLM_FALLBACK=True

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
